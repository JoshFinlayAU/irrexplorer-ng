# IRRd GraphQL endpoint (IRR objects, set expansion, source status). Its
# RPKI source supplies the ROAs for every RPKI column and check, so the IRRd
# needs RPKI import enabled; without it RPKI shows as unavailable.
IRRD_GRAPHQL_URL=https://rr.ntt.net/graphql/
# RIPEstat Data API base URL and the sourceapp value sent on every call.
RIPESTAT_URL=https://stat.ripe.net
RIPESTAT_SOURCEAPP=irrexplorer-ng
# bgp.tools requires an identifying User-Agent with a contact address,
# e.g. "my-irrexplorer bgp.tools - noc@example.net". Without it the
# bgp.tools table is not downloaded and BGP data falls back to RIPE RIS.
BGPTOOLS_USER_AGENT=
BGPTOOLS_URL=https://bgp.tools
# Table dump refresh interval in seconds. bgp.tools asks for 1800 at most often.
BGPTOOLS_REFRESH_SECONDS=7200
# Drop table entries seen by fewer peers than this (the original used 20).
BGPTOOLS_MIN_HITS=20
BGPTOOLS_ENABLED=true
# RIR delegations: NRO combined stats and the Registro.BR allocation list.
RIRSTATS_URL=https://ftp.ripe.net/pub/stats/ripencc/nro-stats/latest/nro-delegated-stats
REGISTROBR_URL=https://ftp.registro.br/pub/numeracao/origin/nicbr-asn-blk-latest.txt
RIRSTATS_REFRESH_SECONDS=86400
# MaxMind GeoLite2 for prefix geolocation. Create a free account at
# https://www.maxmind.com/en/geolite2/signup and a licence key under
# "Manage License Keys". Without both, location is left out.
MAXMIND_ACCOUNT_ID=
MAXMIND_LICENSE_KEY=
MAXMIND_DOWNLOAD_URL=https://download.maxmind.com
# GeoLite2-City (country, city, coordinates) or GeoLite2-Country.
GEOIP_EDITION=GeoLite2-City
# How often to check for a new release, in seconds (at least 3600). Checks are
# HEAD requests and do not count against MaxMind's download limit; the database
# is only downloaded when MaxMind has published a new one.
GEOIP_REFRESH_SECONDS=21600
# PeeringDB, mirrored in memory. An API key is optional but raises the query
# limit; create one under your PeeringDB profile. Read-only access is enough.
PEERINGDB_API_KEY=
PEERINGDB_URL=https://www.peeringdb.com
PEERINGDB_ENABLED=true
# Changes are fetched this often (at least 900 seconds); the whole copy is
# downloaded again every PEERINGDB_FULL_SYNC_SECONDS.
PEERINGDB_REFRESH_SECONDS=3600
PEERINGDB_FULL_SYNC_SECONDS=86400
# Pause between requests during a sync. PeeringDB asks for at least 2 seconds.
PEERINGDB_REQUEST_GAP_MS=2500
# Set to false to skip every bulk download (offline development, tests).
BULK_DATASETS_ENABLED=true
# Queries shorter than these lengths are refused as too large.
MIN_PREFIX_LENGTH_V4=9
MIN_PREFIX_LENGTH_V6=29
# Timeout for batched IRRd lookups (large ASNs), in milliseconds. Slow batches
# are split and retried before giving up.
IRRD_BULK_TIMEOUT_MS=60000
# Stop expanding an AS-set or route-set beyond this many sets.
SET_SIZE_LIMIT=1000
# HTTP port for the production server.
PORT=3000
# TTL of the in-process response cache, in seconds.
CACHE_TTL_SECONDS=600
# Upper bound for the in-process response cache, in megabytes.
CACHE_MAX_MB=256
# Most concurrent calls to IRRd and RIPEstat.
IRRD_MAX_CONCURRENCY=12
RIPESTAT_MAX_CONCURRENCY=8
# Per-request timeout for upstream calls, in milliseconds.
UPSTREAM_TIMEOUT_MS=8000
# Optional directory where raw bulk downloads are kept and reused across
# restarts (respects bgp.tools' 30 minute minimum). Safe to delete.
BULK_CACHE_DIR=
